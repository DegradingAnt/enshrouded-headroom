{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DegradingAnt/enshrouded-headroom/blob/feat/v1/crates/ember-blueprint/schema/blueprint-v1.schema.json",
  "title": "Ember Blueprint 1.0",
  "description": "Structural contract for guide-local blueprint snapshots. Runtime validation additionally enforces unique IDs, references, numeric extents, complete-document budgets and ordered source updates.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "maxItems": 2048
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "maxItems": 10000
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      },
      "maxItems": 1024
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "title",
    "source",
    "frame",
    "stages",
    "layers",
    "anchors",
    "objects"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:/@-]+$"
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 100000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "maxItems": 4096,
      "minItems": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "$ref": "#/$defs/id"
        },
        "content_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "id",
        "adapter",
        "content_version",
        "revision"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sequence",
        "content_sha256"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "units": {
          "const": "metres"
        },
        "axes": {
          "const": "right_handed_x_east_y_up_z_south"
        },
        "source_mapping": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "units",
        "axes",
        "source_mapping"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "name",
        "order"
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "elevation": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "name",
        "elevation"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "point": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "id",
        "name",
        "point"
      ]
    },
    "cutout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "min",
        "size"
      ]
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "fidelity": {
          "enum": [
            "exact_layer",
            "recorded_envelope",
            "approximate_massing",
            "reference_outline"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        }
      },
      "required": [
        "id",
        "fidelity",
        "note",
        "geometry"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 2048
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primitive"
          },
          "maxItems": 100000
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "name",
        "source_ref",
        "stages",
        "primitives",
        "omissions"
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "box"
            },
            "min": {
              "$ref": "#/$defs/point"
            },
            "size": {
              "$ref": "#/$defs/size"
            }
          },
          "required": [
            "kind",
            "min",
            "size"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "slab"
            },
            "min": {
              "$ref": "#/$defs/point"
            },
            "size": {
              "$ref": "#/$defs/size"
            },
            "openings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cutout"
              },
              "maxItems": 4096
            }
          },
          "required": [
            "kind",
            "min",
            "size",
            "openings"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "polyline"
            },
            "points": {
              "$ref": "#/$defs/points"
            },
            "closed": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "points",
            "closed"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "closed": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "points": {
                    "minItems": 3
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wall_path"
            },
            "points": {
              "$ref": "#/$defs/points"
            },
            "thickness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "kind",
            "points",
            "thickness",
            "height"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cylinder"
            },
            "base": {
              "$ref": "#/$defs/point"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "kind",
            "base",
            "radius",
            "height"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "#/$defs/point"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        }
      ]
    }
  }
}
